+            let count: u32 = cocycle
+                .iter_nonzero()
+                .map(|(i, _)| dg.entry(q_s.generator_offset(t, t, i)))
+                .sum();
+            assert!(count % 2 == 0, "not a cocycle");
+            if count % 4 == 2 {
+                w.push(g);
+            }
+        }
+        if w.is_empty() {
+            return;
+        }
+        let d2 = q.differential(s + 2);
+        for (k, _) in (0..q.module(s + 2).number_of_gens_in_degree(t + 1)).map(|k| (k, ())) {
+            let dk = d2.output(t + 1, k);
+            let v: u32 = w
+                .iter()
+                .map(|&g| dk.entry(q_s1.generator_offset(t + 1, t, g)))
+                .sum();
+            if v % 2 == 1 {
+                out.add_basis_element(k, 1);
+            }
+        }
