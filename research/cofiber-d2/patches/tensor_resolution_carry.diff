+    /// The generators of $Q_s$ in degrees `..= t`: (degree, index) ↦ (degree and index of the
+    /// $P_s$-generator, degree and index of the basis element of $M$).
+    fn gen_table(&self, s: i32, t: i32) -> HashMap<(i32, usize), (i32, usize, i32, usize)> {
+        let p_s = self.resolution.module(s);
+        let mut out = HashMap::new();
+        for gen_deg in 0..=t {
+            let mut idx = 0;
+            for (dk, k) in p_s.iter_gens(gen_deg) {
+                if !self.kept(s, dk) {
+                    continue;
+                }
+                let e = gen_deg - dk;
+                for beta in 0..self.module.dimension(e) {
+                    out.insert((gen_deg, idx), (dk, k, e, beta));
+                    idx += 1;
+                }
+            }
+        }
+        out
+    }
