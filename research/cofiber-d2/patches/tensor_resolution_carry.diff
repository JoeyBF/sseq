+    pub fn phi(&self, s: i32, t: i32, input: FpSlice) -> Vec<Vec<FpVector>> {
+        let p = self.resolution.prime();
+        let m_min = self.module.min_degree();
+        let m_max = self.module.max_degree().unwrap_or(m_min);
+        let q = &self.modules[s];
