+    /// Adds the Z/4 carry of a cocycle to its cochain-level d2 (p = 2).
+    ///
+    /// $Q_\bullet$ is not minimal: the cocycle $c$ at `b` has $c \circ d = 0$ mod 2, but with the
+    /// unit coefficients of $d$ lifted to 1 it is $2w$ over Z/4, and $2 = \lambda h_0$ adds $h_0 w$,
+    /// read through the $Sq^1$ coefficients of $d$ out of $Q_{s+2}$.
+    fn add_carry(&self, b: Bidegree, cocycle: fp::vector::FpSlice, out: &mut FpVector) {
+        if self.prime().as_u32() != 2 {
+            return;
+        }
+        let q = &self.resolution;
+        let (s, t) = (b.s(), b.t());
+        let next = Bidegree::s_t(s + 1, t);
+        if !q.has_computed_bidegree(next) || !q.has_computed_bidegree(Bidegree::s_t(s + 2, t + 1))
